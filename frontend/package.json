    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "prisma": "6.19.3",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
