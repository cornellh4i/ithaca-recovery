{
  "name": "frontend",
  "version": "2026.8.3",
  "private": true,
  "scripts": {
    "dev": "node build-scripts/generate-docs-content.mjs && next dev",
    "build": "node build-scripts/generate-docs-content.mjs && node build-scripts/generate-pagefind-index.mjs && prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi && next build",
    "start": "next start",
    "lint": "eslint --config config/eslint.config.mjs .",
    "lint:fix": "eslint --config config/eslint.config.mjs . --fix",
    "lint:css": "stylelint --config config/stylelint.config.mjs \"{styles,app}/**/*.scss\"",
    "lint:css:fix": "stylelint --config config/stylelint.config.mjs \"{styles,app}/**/*.scss\" --fix",
    "commitlint": "commitlint --config config/commitlint.config.mjs",
    "postinstall": "prisma generate",
    "typecheck": "node build-scripts/generate-docs-content.mjs && next typegen && tsc --noEmit -p .",
    "test:unit": "cross-env TZ=UTC jest --config config/jest.config.ts",
    "test:component": "cross-env TZ=UTC jest --config config/jest.component.config.ts",
    "test:integration": "cross-env TZ=UTC jest --config config/jest.integration.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:all": "yarn lint && yarn lint:css && yarn typecheck && yarn test:unit && yarn test:component && yarn test:integration && yarn test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google-cloud/storage": "^8.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@prisma/client": "6.19.3",
    "@vercel/functions": "^3.9.3",
    "google-auth-library": "^9.6.3",
    "googleapis": "^176.0.0",
    "marked": "^18.0.10",
    "motion": "^13.1.0",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "prisma": "6.19.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "server-only": "^0.0.1",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pagefind": "^1.5.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "**/gaxios/uuid": "^11.1.1",
    "**/teeny-request/uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "24.x"
  }
}
