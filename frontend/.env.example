# Environment Variables for Development/Production
NODE_ENV=

# MongoDB Secret
DATABASE_URL=

# Google OAuth Client Secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar
GOOGLE_CALENDAR_AA=
GOOGLE_CALENDAR_ALANON=
GOOGLE_CALENDAR_OTHER=

# NextAuth Secrets
NEXTAUTH_SECRET=

# Zoom Secret
NEXT_PUBLIC_ZOOM_BASE_API=

# Zoom Account
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom Room Calendars (Google Workspace, one per physical Zoom Room)
GOOGLE_CALENDAR_ZOOM_SERENITY_ROOM=
GOOGLE_CALENDAR_ZOOM_SEEDS_OF_HOPE_ROOM=
GOOGLE_CALENDAR_ZOOM_UNITY_ROOM=
GOOGLE_CALENDAR_ZOOM_ROOM_FOR_IMPROVEMENT=
GOOGLE_CALENDAR_ZOOM_CHILDRENS_ROOM_518=

# Zoom Host Pool (comma-separated licensed Zoom user emails, shared across all rooms —
# each meeting is assigned an available host at creation time, not tied to a fixed room)
ZOOM_HOSTS=

# Backups admin tab (all optional — when unset, dev/CI serve sample data and
# production shows the tab's "not configured" panel; see
# docs/03-development/environment-variables.md)
GCS_BACKUPS_CREDENTIALS=
GCS_WORKING_BUCKET=
GCS_ARCHIVE_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID_READ_READ=
R2_SECRET_ACCESS_KEY_READ_READ=
R2_BUCKET=
GITHUB_BACKUPS_PAT=
GITHUB_BACKUPS_REPO=
