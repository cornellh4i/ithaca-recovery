generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Admin {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  name           String
  role           Role
  googleId       String?
  refreshToken   String?
  tokenExpiresAt Int?
}

model Meeting {
  id                     String               @id @default(auto()) @map("_id") @db.ObjectId
  mid                    String               @unique
  title                  String
  calType                String[]
  description            String
  creator                String
  group                  String
  startDateTime          DateTime             @db.Date
  endDateTime            DateTime             @db.Date
  email                  String
  zoomRoom               String?
  zoomLink               String?
  zid                    String?
  zoomPasscode           String?
  zoomInvitation         String?
  room                   String
  modeType               String
  status                 String               @default("Active")
  isRecurring            Boolean              @default(false)
  recurrencePattern      RecurrencePattern?   @relation("MeetingToRecurrencePattern")
  suspensions            SuspensionPeriod[]   @relation("MeetingToSuspensionPeriod")
  googleCalendarEventId  String?
  googleCalendarEventIds Json?
  googleSyncStatus       String?
  zoomCalendarEventId    String?
  zoomSyncStatus         String?
  zoomHost               String?
  zoomSyncError          String?
  deletedAt              DateTime?
  updatedAt              DateTime?            @updatedAt

  @@index([startDateTime, endDateTime])
  @@index([isRecurring, deletedAt])
  @@index([googleCalendarEventId])
  @@index([zoomHost])
  @@index([room])
  @@index([zoomRoom])
}

model RecurrencePattern {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  mid                String     @unique
  meeting            Meeting    @relation("MeetingToRecurrencePattern", fields: [mid], references: [mid])
  type               String
  startDate          DateTime
  endDate            DateTime?
  numberOfOccurrences Int?
  daysOfWeek         String[]
  firstDayOfWeek     String
  interval           Int
  weekOfMonth        Int?
  dayOfMonth         Int?
  excludedDates      DateTime[] @default([])
}


// One row per suspend→resume cycle for a meeting (never mutated once superseded by a new
// suspension) — real date-range history, not a flag, so past-date calendar views can correctly
// answer "was this meeting suspended on that specific date."
model SuspensionPeriod {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  mid            String
  meeting        Meeting   @relation("MeetingToSuspensionPeriod", fields: [mid], references: [mid])
  from           DateTime
  to             DateTime?
  // GCal event IDs (keyed by calendarId) pre-created for the post-resume series when `to` was set
  // at suspend time. Held here until reconciled into Meeting.googleCalendarEventIds once `to`
  // actually arrives — never promoted early, so the live-series pointer never references a series
  // that hasn't started yet.
  resumeEventIds Json?
  // Whether resumeEventIds has already been copied into Meeting.googleCalendarEventIds by the
  // reconciliation step. Tracked explicitly rather than inferred by comparing JSON blobs.
  promoted       Boolean   @default(false)

  @@index([mid])
}

model User {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  uid  String @unique
}

// Singleton — one document holds the PandaDocs lease-export config for the whole app.
model LeaseSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  leaseStartDate  DateTime @db.Date
  leaseEndDate    DateTime @db.Date
  rooms           Json // { room: string; rate: number; unit: "hr" | "month" }[]
  agentFirstName  String
  agentLastName   String
  agentTitle      String
  agentEmail      String
  agentPhone      String
  agentStreetAddress String
  agentCity       String
  agentState      String
  agentZip        String
  emailTemplate   String
  updatedAt       DateTime @updatedAt
}