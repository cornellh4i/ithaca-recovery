generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  name           String
  privilegeMode  String?
  googleId       String? 
  refreshToken   String?
  accessToken    String?
  tokenExpiresAt Int?
}

model Meeting {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  mid                   String               @unique
  title                 String
  calType               String
  description           String
  creator               String
  group                 String
  startDateTime         DateTime             @db.Date
  endDateTime           DateTime             @db.Date
  email                 String
  zoomAccount           String?
  zoomLink              String?
  zid                   String?
  room                  String
  modeType              String
  isRecurring           Boolean              @default(false)
  recurrencePattern     RecurrencePattern?   @relation("MeetingToRecurrencePattern")
  googleCalendarEventId String?
  syncStatus            String?
  deletedAt             DateTime?
  updatedAt             DateTime?            @updatedAt
}

model RecurrencePattern {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  mid                String     @unique
  meeting            Meeting    @relation("MeetingToRecurrencePattern", fields: [mid], references: [mid])
  type               String
  startDate          DateTime
  endDate            DateTime?
  numberOfOccurrences Int?
  daysOfWeek         String[]
  firstDayOfWeek     String
  interval           Int
  excludedDates      DateTime[] @default([])
}


model User {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  uid  String @unique
}